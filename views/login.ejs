<% layout('layout') -%>
<section>
  <div class="card">
    <h3>Connexion</h3>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/login" method="post" class="form-grid">
      <div class="form-group">
        <label for="identifier">Email ou Nom d'utilisateur</label>
        <input type="text" id="identifier" name="identifier" placeholder="ex: john@exemple.com ou johndoe" required />
      </div>
      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required />
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> Se connecter</button>
        <a href="/register" class="btn btn-link">Créer un compte</a>
      </div>
    </form>
  </div>
</section>